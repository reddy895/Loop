# Project LOOP Backend Environment Configuration Template
# Copy this file to .env for local development

# Database Connection (SQLite for zero-setup local dev, PostgreSQL for production)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth v4 Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="loop_development_super_secret_key_change_in_production_32chars"

# Node Environment
NODE_ENV="development"
PORT=3000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000"

# AI Provider Credentials (Optional - Graceful fallback enabled if not set)
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# OAuth Providers (Optional - Leave blank to use Credentials authentication only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email Delivery Service (Optional - SMTP or mock token logger for dev)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@projectloop.ai"
