{
  "name": "project-loop",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "description": "Project LOOP — Enterprise AI Customer Feedback Intelligence Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "prisma:generate": "npm --prefix backend run db:generate",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "next": "^16.3.6"
  },
  "keywords": [
    "customer-feedback",
    "ai-intelligence",
    "rag",
    "sentiment-analysis",
    "nextjs",
    "vercel"
  ],
  "author": "reddy895",
  "license": "MIT"
}
